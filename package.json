{
  "private": true,
  "type": "module",
  "scripts": {
    "dev:b": "npm --prefix backend run dev",
    "dev:f": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "installCommand": "npm run installCommand:backend && npm run installCommand:frontend",
    "installCommand:backend": "npm --prefix backend install",
    "installCommand:frontend": "npm --prefix frontend install"
  }
}
